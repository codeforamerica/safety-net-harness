{
  "name": "caseworker-portal-demos",
  "version": "1.0.0",
  "description": "Caseworker portal demos for the Safety Net Blueprint",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
